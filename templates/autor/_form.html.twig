{{ form_start(form) }}

<div class="card shadow-sm">
    <div class="card-body">
        {{ form_row(form.nome, {
            label: 'Nome do autor',
            attr: {
                class: 'form-control',
                placeholder: 'Ex.: Machado de Assis'
            }
        }) }}
    </div>
</div>

<div class="mt-4 d-flex gap-2">
    <button class="btn btn-primary">
        <i class="bi bi-check-lg me-1"></i>
        {{ button_label|default('Salvar') }}
    </button>

    <a href="{{ path('app_autor_index') }}" class="btn btn-outline-secondary">
        Cancelar
    </a>
</div>

{{ form_end(form) }}
