{% extends 'base.html.twig' %}

{% block title %}Relatório por Autor{% endblock %}

{% block body %}

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>
        <h2 class="mb-1">
            <i class="bi bi-bar-chart-line me-2"></i>
            Relatório de Livros por Autor
        </h2>

        <p class="text-secondary mb-0">
            Dados obtidos através da view
            <code>vw_relatorio_livros</code>.
        </p>
    </div>

    <a href="{{ path('app_relatorio_pdf') }}"
       target="_blank"
       class="btn btn-danger">

        <i class="bi bi-file-earmark-pdf me-1"></i>
        Exportar PDF

    </a>

</div>

{% set autorAtual = null %}

{% for item in relatorio %}

    {% if autorAtual != item.autor_nome %}

        {% if autorAtual is not null %}
                </tbody>
            </table>
        </div>
    </div>
        {% endif %}

        {% set autorAtual = item.autor_nome %}

        <div class="card shadow-sm mb-4">

            <div class="card-header bg-light fw-bold">
                <i class="bi bi-person-fill me-2"></i>
                {{ item.autor_nome }}
            </div>

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead>
                        <tr>
                            <th>Livro</th>
                            <th>Editora</th>
                            <th>Edição</th>
                            <th>Ano</th>
                            <th class="text-end">Valor</th>
                            <th>Assuntos</th>
                        </tr>
                    </thead>

                    <tbody>

    {% endif %}

                        <tr>

                            <td class="fw-semibold">
                                {{ item.livro_titulo }}
                            </td>

                            <td>
                                {{ item.editora }}
                            </td>

                            <td class="text-center">
                                {{ item.edicao }}
                            </td>

                            <td class="text-center">
                                {{ item.ano_publicacao }}
                            </td>

                            <td class="text-end">
                                R$ {{ item.valor|number_format(2, ',', '.') }}
                            </td>

                            <td>
                                {{ item.assuntos }}
                            </td>

                        </tr>

{% else %}

    <div class="alert alert-info">
        Nenhum dado encontrado para o relatório.
    </div>

{% endfor %}

{% if autorAtual is not null %}
                </tbody>
            </table>
        </div>
    </div>
{% endif %}

{% endblock %}