<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">

    <title>Relatório de Livros por Autor</title>

    <style>
        body {
            font-family: Arial, Helvetica, sans-serif;
            font-size: 11px;
            color: #222;
        }

        h1 {
            margin: 0;
            font-size: 20px;
        }

        .subtitle {
            margin-top: 4px;
            margin-bottom: 20px;
            color: #666;
            font-size: 11px;
        }

        .autor {
            margin-top: 18px;
            margin-bottom: 6px;
            padding: 8px;
            background: #e9ecef;
            font-size: 13px;
            font-weight: bold;
            border: 1px solid #d0d0d0;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 18px;
            font-size: 10px;
        }

        th,
        td {
            border: 1px solid #cfcfcf;
            padding: 6px;
            vertical-align: top;
        }

        th {
            background: #f3f3f3;
            font-weight: bold;
        }

        .center {
            text-align: center;
        }

        .right {
            text-align: right;
            white-space: nowrap;
        }

        .footer {
            margin-top: 20px;
            padding-top: 8px;
            border-top: 1px solid #ccc;
            font-size: 10px;
            color: #666;
        }
    </style>
</head>

<body>

<h1>Relatório de Livros por Autor</h1>

<p class="subtitle">
    Emitido em {{ "now"|date("d/m/Y H:i") }}<br>
    Relatório gerado a partir da view <strong>vw_relatorio_livros</strong>.
</p>

{% set autorAtual = null %}

{% for item in relatorio %}

    {% if autorAtual != item.autor_nome %}

        {% if autorAtual is not null %}
                </tbody>
            </table>
        {% endif %}

        {% set autorAtual = item.autor_nome %}

        <div class="autor">
            {{ item.autor_nome }}
        </div>

        <table>

            <thead>
                <tr>
                    <th>Livro</th>
                    <th>Editora</th>
                    <th>Edição</th>
                    <th>Ano</th>
                    <th>Valor</th>
                    <th>Assuntos</th>
                </tr>
            </thead>

            <tbody>

    {% endif %}

                <tr>

                    <td>{{ item.livro_titulo }}</td>

                    <td>{{ item.editora }}</td>

                    <td class="center">
                        {{ item.edicao }}
                    </td>

                    <td class="center">
                        {{ item.ano_publicacao }}
                    </td>

                    <td class="right">
                        R$ {{ item.valor|number_format(2, ',', '.') }}
                    </td>

                    <td>{{ item.assuntos }}</td>

                </tr>

{% else %}

    <p>Nenhum dado encontrado.</p>

{% endfor %}

{% if autorAtual is not null %}
        </tbody>
    </table>
{% endif %}

<div class="footer">
    Total de registros: {{ relatorio|length }}
</div>

</body>
</html>