{% extends 'base.html.twig' %}

{% block title %}Livros{% endblock %}

{% block body %}

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>
        <h1 class="h3 mb-1">
            <i class="bi bi-book me-2"></i>
            Livros
        </h1>

        <p class="text-secondary mb-0">
            Gerencie os livros cadastrados no catálogo.
        </p>
    </div>

    <a href="{{ path('app_livro_new') }}"
       class="btn btn-success">
        <i class="bi bi-plus-circle me-1"></i>
        Novo livro
    </a>

</div>

<div class="card shadow-sm">
    <div class="card-body p-0">

        <div class="table-responsive">

            <table class="table table-hover align-middle table-sm mb-0">

                <thead class="table-light">
                    <tr>
                        <th style="width:80px">ID</th>
                        <th style="width:280px">Título</th>
                        <th style="width:170px">Editora</th>
                        <th style="width:70px">Edição</th>
                        <th style="width:70px">Ano</th>
                        <th style="width:120px">Valor</th>
                        <th>Autores</th>
                        <th>Assuntos</th>
                        <th class="text-end">Ações</th>
                    </tr>
                </thead>

                <tbody>

                {% for livro in livros %}

                    <tr>

                        <td>{{ livro.id }}</td>

                        <td class="fw-semibold">
                            {{ livro.titulo }}
                        </td>

                        <td>{{ livro.editora }}</td>

                        <td>{{ livro.edicao }}</td>

                        <td>{{ livro.anoPublicacao }}</td>

                        <td class="text-nowrap">
                            R$ {{ livro.valor|number_format(2, ',', '.') }}
                        </td>

                        <td>
                            {% for autor in livro.autores %}
                                <span class="badge text-bg-primary me-1">
                                    {{ autor.nome }}
                                </span>
                            {% else %}
                                <span class="text-secondary">Nenhum</span>
                            {% endfor %}
                        </td>

                        <td>
                            {% for assunto in livro.assuntos %}
                                <span class="badge text-bg-warning text-dark border me-1">
                                    {{ assunto.descricao }}
                                </span>
                            {% else %}
                                <span class="text-secondary">Nenhum</span>
                            {% endfor %}
                        </td>

                        <td class="text-end text-nowrap">

                            <a href="{{ path('app_livro_show', {'id': livro.id}) }}"
                               class="btn btn-sm btn-outline-secondary"
                               title="Visualizar">
                                <i class="bi bi-eye"></i>
                            </a>

                            <a href="{{ path('app_livro_edit', {'id': livro.id}) }}"
                               class="btn btn-sm btn-outline-primary"
                               title="Editar">
                                <i class="bi bi-pencil"></i>
                            </a>

                        </td>

                    </tr>

                {% else %}

                    <tr>
                        <td colspan="9"
                            class="text-center py-5 text-secondary">
                            Nenhum livro cadastrado.
                        </td>
                    </tr>

                {% endfor %}

                </tbody>

            </table>

        </div>

    </div>
</div>

{% endblock %}