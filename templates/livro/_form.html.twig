{{ form_start(form) }}

<div class="row g-3">

    <div class="col-md-8">
        {{ form_row(form.titulo, {
            label: 'Título',
            attr: {
                class: 'form-control'
            }
        }) }}
    </div>

    <div class="col-md-4">
        {{ form_row(form.editora, {
            label: 'Editora',
            attr: {
                class: 'form-control'
            }
        }) }}
    </div>

    <div class="col-md-4">
        {{ form_row(form.edicao, {
            label: 'Edição',
            attr: {
                class: 'form-control',
                min: 1
            }
        }) }}
    </div>

    <div class="col-md-4">
        {{ form_row(form.anoPublicacao, {
            label: 'Ano de publicação',
            attr: {
                class: 'form-control',
                maxlength: 4,
                placeholder: 'Ex.: 2026'
            }
        }) }}
    </div>

    <div class="col-md-4">
        {{ form_row(form.valor, {
            label: 'Valor (R$)',
            attr: {
                class: 'form-control',
                step: '0.01',
                placeholder: 'Ex.: 49.90'
            }
        }) }}
    </div>

    <div class="col-md-6">
        {{ form_row(form.autores, {
            label: 'Autores',
            attr: {
                class: 'form-select'
            }
        }) }}
    </div>

    <div class="col-md-6">
        {{ form_row(form.assuntos, {
            label: 'Assuntos',
            attr: {
                class: 'form-select'
            }
        }) }}
    </div>

</div>

<div class="mt-4 d-flex gap-2">

    <button class="btn btn-primary">
        <i class="bi bi-check-lg me-1"></i>
        {{ button_label|default('Salvar') }}
    </button>

    <a href="{{ path('app_livro_index') }}"
       class="btn btn-outline-secondary">
        Cancelar
    </a>

</div>

{{ form_end(form) }}