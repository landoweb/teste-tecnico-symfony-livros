<form method="post"
      action="{{ path('app_livro_delete', {'id': livro.id}) }}"
      onsubmit="return confirm('Tem certeza que deseja excluir este livro?');">

    <input type="hidden"
           name="_token"
           value="{{ csrf_token('delete' ~ livro.id) }}">

    <button class="btn btn-outline-danger">
        <i class="bi bi-trash me-1"></i>
        Excluir livro
    </button>

</form>
