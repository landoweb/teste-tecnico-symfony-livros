<form method="post"
      action="{{ path('app_assunto_delete', {'id': assunto.id}) }}"
      onsubmit="return confirm('Tem certeza que deseja excluir este assunto?');">

    <input type="hidden"
           name="_token"
           value="{{ csrf_token('delete' ~ assunto.id) }}">

    <button class="btn btn-outline-danger">
        <i class="bi bi-trash me-1"></i>
        Excluir assunto
    </button>

</form>
