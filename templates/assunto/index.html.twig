{% extends 'base.html.twig' %}

{% block title %}Assuntos{% endblock %}

{% block body %}

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>
        <h1 class="h3 mb-1">
            <i class="bi bi-tags me-2"></i>
            Assuntos
        </h1>

        <p class="text-secondary mb-0">
            Gerencie os assuntos cadastrados no catálogo.
        </p>
    </div>

    <a href="{{ path('app_assunto_new') }}"
       class="btn btn-success">
        <i class="bi bi-plus-circle me-1"></i>
        Novo assunto
    </a>

</div>

<div class="card shadow-sm">
    <div class="card-body">

        <table class="table table-hover align-middle mb-0">

            <thead>
                <tr>
                    <th width="70">ID</th>
                    <th>Descrição</th>
                    <th width="180">Ações</th>
                </tr>
            </thead>

            <tbody>

            {% for assunto in assuntos %}
                <tr>

                    <td>{{ assunto.id }}</td>

                    <td>{{ assunto.descricao }}</td>

                    <td>

                        <a href="{{ path('app_assunto_show', {'id': assunto.id}) }}"
                           class="btn btn-sm btn-outline-secondary">
                            Visualizar
                        </a>

                        <a href="{{ path('app_assunto_edit', {'id': assunto.id}) }}"
                           class="btn btn-sm btn-outline-primary">
                            Editar
                        </a>

                    </td>

                </tr>

            {% else %}

                <tr>
                    <td colspan="3" class="text-center text-muted">
                        Nenhum assunto cadastrado.
                    </td>
                </tr>

            {% endfor %}

            </tbody>

        </table>

    </div>

    {% if assuntos.pageCount > 1 %}
        <div class="d-flex justify-content-center mt-4">
            {{ knp_pagination_render(assuntos) }}
        </div>
    {% endif %}

</div>

{% endblock %}